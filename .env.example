# Copy to .env and fill in. .env is gitignored.
# All overrides are optional — they take precedence over config/config.yaml.

# ---- Alerts ----
NSE_TELEGRAM_BOT_TOKEN=
NSE_TELEGRAM_CHAT_ID=

# Email sink (optional; off by default)
NSE_ALERT_EMAIL_SMTP_HOST=
NSE_ALERT_EMAIL_SMTP_PORT=587
NSE_ALERT_EMAIL_USERNAME=
NSE_ALERT_EMAIL_PASSWORD=
NSE_ALERT_EMAIL_FROM=
NSE_ALERT_EMAIL_TO=

# Discord webhook (optional)
NSE_DISCORD_WEBHOOK_URL=

# Generic webhook sink (optional)
NSE_WEBHOOK_URL=

# ---- Optional LLM copilot (future) ----
ANTHROPIC_API_KEY=

# ---- Storage backend override ----
# Default is SQLite at config.storage.db_path. Set to a SQLAlchemy URL to override.
NSE_DB_URL=
